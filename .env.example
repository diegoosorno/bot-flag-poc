# Environment variable template for upload_classifications.py
#
# HOW TO USE:
#   1. Copy this file to .env:   cp .env.example .env
#   2. Fill in the real values in .env
#   3. .env is in .gitignore and must NEVER be pushed to the repo (it is public)
#
# Do not put quotes around the values.

# --- Required ---
ADOBE_CLIENT_ID=your_developer_console_client_id
ADOBE_CLIENT_SECRET=your_client_secret
ADOBE_DATASET_ID=id_of_the_evar23_classification_dataset

# --- Optional ---
# Report suite ID. Used with `--list-datasets` to discover the
# ADOBE_DATASET_ID for eVar23. Can also be passed with --rsid on the CLI.
ADOBE_RSID=your_report_suite_id

# Global company id. If left empty, the script discovers it via the Discovery API.
ADOBE_COMPANY_ID=

# OAuth scopes. If left empty, uses the default from config.py (DEFAULT_SCOPES).
ADOBE_SCOPES=
