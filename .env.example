# Plantilla de variables de entorno para upload_classifications.py
#
# CÓMO USAR:
#   1. Copia este archivo a .env:   cp .env.example .env
#   2. Rellena los valores reales en .env
#   3. .env está en .gitignore y NUNCA debe subirse al repo (es público)
#
# No pongas comillas alrededor de los valores.

# --- Requeridas ---
ADOBE_CLIENT_ID=tu_client_id_de_developer_console
ADOBE_CLIENT_SECRET=tu_client_secret
ADOBE_DATASET_ID=id_del_dataset_de_clasificacion_de_evar23

# --- Opcionales ---
# Global company id. Si lo dejas vacío, el script lo descubre vía Discovery API.
ADOBE_COMPANY_ID=

# Scopes OAuth. Si lo dejas vacío, usa el default de config.py (DEFAULT_SCOPES).
ADOBE_SCOPES=
