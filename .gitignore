# Do not push real data (ECID is visitor information — it must not
# end up in a GitHub repo, even a private one).
input/*
!input/.gitkeep

output/*
!output/.gitkeep

# Secrets / credentials — NEVER push to the repo (it is public)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
