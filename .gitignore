# No subir datos reales (ECID es información de visitante — no debe
# terminar en un repo de GitHub, aunque sea privado).
input/*
!input/.gitkeep

output/*
!output/.gitkeep

# Secretos / credenciales — NUNCA subir al repo (es público)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
